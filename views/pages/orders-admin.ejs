<%- include('../partials/header',{title:'Pedidos'}) %><div class="page-head"><h1>Pedidos de tienda</h1></div><div class="table-wrap"><table><thead><tr><th>#</th><th>Usuario</th><th>Total</th><th>Personalización</th><th>Estado</th></tr></thead><tbody><%orders.forEach(o=>{%><tr><td>#<%=o.id%></td><td><%=o.user_name||'—'%><small><%=o.email||''%></small></td><td>$<%=Number(o.total).toLocaleString('es-CO')%></td><td><%=o.name||'—'%> #<%=o.dorsal||'—'%> / <%=o.size||'—'%></td><td><form method="post" action="/pedidos/<%=o.id%>/estado"><select name="status"><%['pending','confirmed','production','ready','delivered','cancelled'].forEach(s=>{%><option <%=o.status===s?'selected':''%>><%=s%></option><%})%></select><button class="ghost">Guardar</button></form></td></tr><%})%></tbody></table></div><%- include('../partials/footer') %>
