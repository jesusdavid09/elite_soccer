<%- include('../partials/header',{title:'Inicio'}) %>

<section class="hero">

    <div class="hero-bg"></div>

    <div class="hero-content">

        <span class="eyebrow">
            CLUB DE FÚTBOL
        </span>

        <h1>
            ELITE<br>
            <em>SOCCER</em>
        </h1>

        <p>
            Talento. Disciplina. Corazón.
        </p>

        <div class="actions">

            <a class="btn" href="/equipo">
                Conoce el equipo
            </a>

            <a class="btn outline" href="/unete">
                Únete a Elite Soccer
            </a>

            <% if (!user) { %>
                <a class="btn outline" href="/login">
                    🔐 Acceso
                </a>
            <% } else { %>
                <a class="btn outline" href="/dashboard">
                    📊 Panel de control
                </a>
            <% } %>

        </div>

    </div>

</section>

<!-- ============================================================ -->
<!-- PRÓXIMOS PARTIDOS -->
<!-- ============================================================ -->

<section class="section">

    <div class="section-head">

        <div>
            <span class="eyebrow">
                COMPETICIÓN
            </span>

            <h2>
                Próximos partidos
            </h2>
        </div>

        <a href="/partidos">
            Ver todos →
        </a>

    </div>

    <% if (matches && matches.length > 0) { %>

        <div class="grid cards">

            <% matches.forEach(m => { %>

                <article class="card match">

                    <span>
                        <%= m.competition || 'Partido' %>
                    </span>

                    <h3>
                        ELITE SOCCER
                        <b>VS</b>
                        <%= m.opponent || 'Por definir' %>
                    </h3>

                    <p>
                        <% 
                            let dateStr = 'Fecha por confirmar';
                            if (m.match_date) {
                                try {
                                    const d = new Date(m.match_date);
                                    if (!isNaN(d.getTime())) {
                                        dateStr = d.toLocaleDateString('es-CO');
                                    }
                                } catch(e) {}
                            }
                        %>
                        <%= dateStr %>
                        ·
                        <% 
                            let timeStr = 'Hora por confirmar';
                            if (m.match_time) {
                                timeStr = String(m.match_time).slice(0,5);
                            }
                        %>
                        <%= timeStr %>
                        ·
                        <%= m.location || 'Por confirmar' %>
                    </p>

                    <% if (m.category_name) { %>
                        <span class="badge">
                            <%= m.category_name %>
                        </span>
                    <% } %>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">
            <p>No hay partidos programados próximamente.</p>
        </div>

    <% } %>

</section>

<!-- ============================================================ -->
<!-- JUGADORES DESTACADOS -->
<!-- ============================================================ -->

<section class="section">

    <div class="section-head">

        <h2>
            Jugadores destacados
        </h2>

        <a href="/equipo">
            Plantilla →
        </a>

    </div>

    <% if (players && players.length > 0) { %>

        <div class="grid players">

            <% players.forEach(p => { %>

                <a
                    class="player-card"
                    href="/jugadores/<%= p.id %>"
                >

                    <div class="player-photo">

                        <% if (p.photo_url) { %>

                            <img
                                src="<%= p.photo_url %>"
                                alt="<%= p.full_name %>"
                            >

                        <% } else { %>

                            <span class="dorsal-placeholder">
                                <%= p.dorsal || '—' %>
                            </span>

                        <% } %>

                    </div>

                    <div>

                        <strong>
                            <%= p.full_name || 'Jugador' %>
                        </strong>

                        <small>
                            #<%= p.dorsal || '—' %>
                            ·
                            <%= p.position || 'Jugador' %>
                        </small>

                    </div>

                </a>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">
            <p>No hay jugadores registrados aún.</p>
        </div>

    <% } %>

</section>

<!-- ============================================================ -->
<!-- ÚLTIMAS NOTICIAS -->
<!-- ============================================================ -->

<section class="section news-strip">

    <div class="section-head">

        <h2>
            Últimas noticias
        </h2>

        <a href="/noticias">
            Noticias →
        </a>

    </div>

    <% if (news && news.length > 0) { %>

        <div class="grid cards">

            <% news.forEach(n => { %>

                <a
                    class="card"
                    href="/noticias/<%= n.slug %>"
                >

                    <small>
                        NOTICIA
                    </small>

                    <h3>
                        <%= n.title || 'Sin título' %>
                    </h3>

                    <p>
                        <%= n.excerpt || '' %>
                    </p>

                    <% if (n.published_at) { 
                        let dateStr = '';
                        try {
                            const d = new Date(n.published_at);
                            if (!isNaN(d.getTime())) {
                                dateStr = d.toLocaleDateString('es-CO');
                            }
                        } catch(e) {}
                    %>
                        <small class="date">
                            <%= dateStr %>
                        </small>
                    <% } %>

                </a>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">
            <p>No hay noticias publicadas aún.</p>
        </div>

    <% } %>

</section>

<%- include('../partials/footer') %>