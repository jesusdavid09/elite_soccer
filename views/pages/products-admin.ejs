<%- include('../partials/header',{title:'Productos'}) %><div class="page-head"><h1>Gestión de tienda</h1></div><form method="post" enctype="multipart/form-data" class="panel form grid-form"><label>Producto<input name="name" required></label><label>Precio<input name="price" type="number" step="0.01" required></label><label>Stock<input name="stock" type="number" required></label><label>Imagen<input name="image" type="file" accept="image/*"></label><label class="full-row">Descripción<textarea name="description"></textarea></label><button class="btn">Crear producto</button></form><div class="grid cards"><%products.forEach(p=>{%><article class="card"><%if(p.image_url){%><img class="product-img" src="<%=p.image_url%>"><%}%><h3><%=p.name%></h3><p>$<%=Number(p.price).toLocaleString('es-CO')%> · Stock <%=p.stock%></p></article><%})%></div><%- include('../partials/footer') %>
