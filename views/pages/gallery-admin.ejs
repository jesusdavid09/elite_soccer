<%- include('../partials/header',{title:'Gestionar galería'}) %><div class="page-head"><h1>Gestionar galería</h1></div><form method="post" action="/galeria/admin" enctype="multipart/form-data" class="panel form grid-form"><label>Álbum<input name="name" required></label><label>Fecha<input type="date" name="event_date"></label><label>Portada<input type="file" name="cover" accept="image/*"></label><label class="full-row">Descripción<textarea name="description"></textarea></label><button class="btn">Crear álbum</button></form><div class="grid cards"><%albums.forEach(a=>{%><article class="card"><%if(a.cover_url){%><img class="product-img" src="<%=a.cover_url%>"><%}%><h3><%=a.name%></h3><p><%=a.description||''%></p></article><%})%></div><%- include('../partials/footer') %>
