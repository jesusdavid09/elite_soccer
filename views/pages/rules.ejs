<%- include('../partials/header',{title:'Reglamento'}) %><div class="page-head"><h1>Reglamento Elite Soccer</h1></div><%rules.forEach(r=>{%><article class="panel rule"><span>VERSIÓN <%=r.version%></span><h2><%=r.title%></h2><div><%=r.content%></div><form method="post" action="/reglamento/<%=r.id%>/aceptar"><button class="btn">He leído y acepto</button></form></article><%})%><%if(user.role==='admin'){%><form method="post" class="panel form"><h2>Nueva versión</h2><input name="title" placeholder="Título" required><input name="version" placeholder="1.0" required><textarea name="content" placeholder="Contenido" required></textarea><button class="btn">Publicar</button></form><%}%><%- include('../partials/footer') %>
