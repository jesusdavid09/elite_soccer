<%- include('../partials/header',{title:'Dashboard'}) %><div class="page-head"><div><span class="eyebrow">CENTRO DE MANDO</span><h1>Hola, <%=user.name%></h1><p class="muted">Rol: <%=user.role%></p></div></div><div class="stats"><div><span>JUGADORES</span><strong><%=stats.players%></strong></div><div><span>PEDIDOS ACTIVOS</span><strong><%=stats.orders%></strong></div><div><span>PAGOS PENDIENTES</span><strong><%=stats.payments%></strong></div></div><div class="dashboard-grid"><section class="panel"><div class="section-head"><h2>Próximos entrenamientos</h2><a href="/entrenamientos">Ver →</a></div><% trainings.forEach(t=>{ %><div class="list-row"><div><strong><%=t.title%></strong><small><%=t.date.toLocaleDateString('es-CO')%> · <%=String(t.start_time).slice(0,5)%> · <%=t.location||''%></small></div><a class="btn tiny" href="/entrenamientos/<%=t.id%>/asistencia">Asistencia</a></div><% }) %></section><section class="panel"><div class="section-head"><h2>Próximos partidos</h2><a href="/partidos">Ver →</a></div><% matches.forEach(m=>{ %><div class="list-row"><div><strong>VS <%=m.opponent%></strong><small><%=m.match_date.toLocaleDateString('es-CO')%> · <%=String(m.match_time||'').slice(0,5)%></small></div><a class="btn tiny" href="/partidos/<%=m.id%>">Abrir</a></div><% }) %></section></div><section class="quick-grid"><% const links=[['👥','Jugadores','/jugadores'],['🏃','Entrenamientos','/entrenamientos'],['⚽','Partidos','/partidos'],['🧠','Pizarra','/pizarra'],['📊','Evaluaciones','/evaluaciones'],['🔔','Notificaciones','/notificaciones'],['📦','Pedidos','/pedidos'],['📅','Calendario','/calendario']]; links.forEach(l=>{ %><a class="quick" href="<%=l[2]%>"><span><%=l[0]%></span><strong><%=l[1]%></strong></a><% }) %></section><%- include('../partials/footer') %>
