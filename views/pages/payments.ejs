<%- include('../partials/header',{title:'Pagos'}) %><div class="page-head"><h1>Pagos</h1></div><%if(user.role==='admin'){%><form method="post" class="panel form grid-form"><label>Jugador ID<input name="player_id" type="number"></label><label>Usuario ID<input name="user_id" type="number"></label><label>Concepto<input name="concept" required></label><label>Valor<input name="amount" type="number" step="0.01" required></label><label>Estado<select name="status"><option>pending</option><option>paid</option><option>overdue</option></select></label><label>Vencimiento<input type="date" name="due_date"></label><button class="btn">Registrar</button></form><%}%><div class="table-wrap"><table><thead><tr><th>Concepto</th><th>Jugador</th><th>Valor</th><th>Estado</th><th>Vence</th></tr></thead><tbody><%payments.forEach(p=>{%><tr><td><%=p.concept%></td><td><%=p.player_name||'—'%></td><td>$<%=Number(p.amount).toLocaleString('es-CO')%></td><td><%=p.status%></td><td><%=p.due_date?p.due_date.toLocaleDateString('es-CO'):'—'%></td></tr><%})%></tbody></table></div><%- include('../partials/footer') %>
