<%- include('../partials/header',{title:'Partido'}) %><section class="match-hero"><span><%=match.competition||'PARTIDO'%></span><h1>ELITE SOCCER <strong><%=match.elite_goals!=null?match.elite_goals:'—'%></strong> — <strong><%=match.opponent_goals!=null?match.opponent_goals:'—'%></strong> <%=match.opponent%></h1><p><%=match.match_date.toLocaleDateString('es-CO')%> · <%=String(match.match_time||'').slice(0,5)%> · <%=match.location||'—'%></p></section><%if(['admin','coach'].includes(user.role)){%><div class="panel"><h2>Resultado</h2><form class="inline-form" method="post" action="/partidos/<%=match.id%>/resultado"><input type="number" name="elite_goals" min="0" placeholder="Elite"><input type="number" name="opponent_goals" min="0" placeholder="Rival"><button class="btn">Guardar</button></form><a class="btn outline" href="/partidos/<%=match.id%>/convocatoria">Gestionar convocatoria</a></div><%}%><section class="panel"><div class="section-head"><h2>Convocados</h2></div><div class="chips"><%callups.forEach(c=>{%><span class="chip"><%=c.full_name%> · <%=c.status%><%if(user.role==='player'&&c.status==='pending'){%><form method="post" action="/convocatorias/<%=c.id%>/respuesta"><input type="hidden" name="status" value="confirmed"><button>Confirmar</button></form><%}%></span><%})%></div></section><section class="panel"><h2>Eventos</h2><div class="timeline"><%events.forEach(e=>{%><div><b><%=e.minute||'—'%>'</b> <%=e.event_type%> · <%=e.full_name||'Equipo'%></div><%})%></div></section><%- include('../partials/footer') %>
