<%- include('../partials/header',{title:'Entrenamientos'}) %><div class="page-head"><div><span class="eyebrow">PLANIFICACIÓN</span><h1>Entrenamientos</h1></div><%if(['admin','coach'].includes(user.role)){%><a class="btn" href="/entrenamientos/nuevo">+ Nuevo entrenamiento</a><%}%></div><div class="grid cards"><%trainings.forEach(t=>{%><article class="card"><span><%=t.training_type%></span><h3><%=t.title%></h3><p><%=t.date.toLocaleDateString('es-CO')%> · <%=String(t.start_time).slice(0,5)%></p><p><%=t.location||'Lugar por confirmar'%> · <%=t.duration_minutes||'—'%> min</p><%if(['admin','coach'].includes(user.role)){%><a class="btn tiny" href="/entrenamientos/<%=t.id%>/asistencia">Control de asistencia</a><%}%></article><%})%></div><%- include('../partials/footer') %>
