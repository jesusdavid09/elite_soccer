<%- include('../partials/header',{title:'Nuevo partido'}) %><div class="page-head"><h1>Crear partido</h1></div><form class="panel form grid-form" method="post" action="/partidos"><label>Rival<input name="opponent" required></label><label>Competición<input name="competition"></label><label>Fecha<input type="date" name="match_date" required></label><label>Hora<input type="time" name="match_time"></label><label>Lugar<input name="location"></label><label>Local/visitante<select name="home_away"><option value="home">Local</option><option value="away">Visitante</option></select></label><label>Categoría<select name="category_id"><option value="">Sin categoría</option><%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></label><label class="full-row">Notas<textarea name="notes"></textarea></label><div class="full-row"><button class="btn">Crear partido</button></div></form><%- include('../partials/footer') %>
