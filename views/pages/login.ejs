<%- include('../partials/header', { title: 'Iniciar sesión' }) %>

<section class="auth-page">

  <div class="auth-card">

    <img
      src="/images/elite-soccer-logo.png"
      alt="Elite Soccer"
    >

    <span class="eyebrow">
      ELITE SOCCER
    </span>

    <h1>
      Iniciar sesión
    </h1>

    <p class="muted center">
      Accede a tu cuenta del club.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>

      <div class="alert danger">
        <%= error %>
      </div>

    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>

      <div class="alert success">
        <%= success %>
      </div>

    <% } %>

    <form
      method="post"
      action="/login"
      class="form"
      id="loginForm"
    >

      <label>

        Correo electrónico

        <input
          type="email"
          name="email"
          value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>"
          autocomplete="email"
          placeholder="correo@ejemplo.com"
          required
        >

      </label>

      <label>

        Contraseña

        <input
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="Tu contraseña"
          required
        >

      </label>

      <label
        class="remember-row"
      >

        <input
          type="checkbox"
          name="remember"
          value="true"
        >

        <span>
          Mantener mi sesión iniciada
        </span>

      </label>

      <button
        class="btn full"
        type="submit"
        id="loginButton"
      >
        INICIAR SESIÓN
      </button>

    </form>

    <div class="register-link">

      <p class="muted">

        ¿No tienes una cuenta?

        <a
          href="/registro"
          class="link-blue"
        >
          Crear cuenta
        </a>

      </p>

    </div>

    <% if (
      typeof demoEmail !== 'undefined' &&
      demoEmail &&
      typeof demoPassword !== 'undefined' &&
      demoPassword
    ) { %>

      <div class="demo-login">

        <p>
          Cuenta de demostración
        </p>

        <p>
          <strong>
            <%= demoEmail %>
          </strong>
        </p>

        <p>
          Contraseña:
          <strong>
            <%= demoPassword %>
          </strong>
        </p>

      </div>

    <% } %>

  </div>

</section>

<script>

(function () {

  const form = document.getElementById('loginForm');

  const button = document.getElementById('loginButton');

  if (!form || !button) {
    return;
  }

  form.addEventListener('submit', function () {

    button.disabled = true;

    button.textContent = 'INICIANDO SESIÓN...';

  });

})();

</script>

<%- include('../partials/footer') %>