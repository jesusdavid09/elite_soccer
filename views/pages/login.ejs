<%- include('../partials/header', { title: 'Iniciar sesión' }) %>

<section class="auth-page">

  <div class="auth-card">

    <!-- ============================================================
         LOGO
    ============================================================ -->

    <img
      src="/images/elite-soccer-logo.png"
      alt="Elite Soccer"
    >


    <!-- ============================================================
         ENCABEZADO
    ============================================================ -->

    <span class="eyebrow">
      ELITE SOCCER
    </span>

    <h1>
      Iniciar sesión
    </h1>

    <p class="muted center">
      Accede a tu cuenta del club.
    </p>


    <!-- ============================================================
         MENSAJE DE ERROR
    ============================================================ -->

    <% if (typeof error !== 'undefined' && error) { %>

      <div class="alert danger">
        <%= error %>
      </div>

    <% } %>


    <!-- ============================================================
         MENSAJE DE ÉXITO
    ============================================================ -->

    <% if (typeof success !== 'undefined' && success) { %>

      <div class="alert success">
        <%= success %>
      </div>

    <% } %>


    <!-- ============================================================
         FORMULARIO
    ============================================================ -->

    <form
      method="post"
      action="/login"
      class="form"
      id="loginForm"
    >

      <!-- CORREO -->

      <label>

        Correo electrónico

        <input
          type="email"
          name="email"
          value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>"
          autocomplete="email"
          placeholder="correo@ejemplo.com"
          required
        >

      </label>


      <!-- CONTRASEÑA -->

      <label>

        Contraseña

        <input
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="Tu contraseña"
          required
        >

      </label>


      <!-- RECORDAR SESIÓN -->

      <label
        style="
          flex-direction:row;
          align-items:center;
          gap:9px;
          cursor:pointer;
        "
      >

        <input
          type="checkbox"
          name="remember"
          value="true"
          style="
            width:auto;
            accent-color:var(--blue);
          "
        >

        <span>
          Mantener mi sesión iniciada
        </span>

      </label>


      <!-- BOTÓN -->

      <button
        class="btn full"
        type="submit"
      >
        INICIAR SESIÓN
      </button>

    </form>


    <!-- ============================================================
         REGISTRO
    ============================================================ -->

    <div class="register-link">

      <p class="muted">

        ¿No tienes una cuenta?

        <a
          href="/registro"
          class="link-blue"
        >
          Crear cuenta
        </a>

      </p>

    </div>


    <!-- ============================================================
         ACCESO DEMO
         Solo se muestra si el servidor envía demoEmail/demoPassword
    ============================================================ -->

    <% if (
      typeof demoEmail !== 'undefined' &&
      demoEmail &&
      typeof demoPassword !== 'undefined' &&
      demoPassword
    ) { %>

      <div class="demo-login">

        <p>
          Cuenta de demostración
        </p>

        <p>
          <strong>
            <%= demoEmail %>
          </strong>
        </p>

        <p>
          Contraseña:
          <strong>
            <%= demoPassword %>
          </strong>
        </p>

      </div>

    <% } %>

  </div>

</section>


<!-- ================================================================
     JAVASCRIPT
================================================================ -->

<script>

(function () {

  const form =
    document.getElementById('loginForm');

  if (!form) {
    return;
  }


  form.addEventListener('submit', function () {

    const button =
      form.querySelector('button[type="submit"]');

    if (!button) {
      return;
    }

    /*
     * Evita enviar el formulario varias veces
     * accidentalmente.
     */

    button.disabled = true;

    button.textContent =
      'INICIANDO SESIÓN...';

  });

})();

</script>


<%- include('../partials/footer') %>