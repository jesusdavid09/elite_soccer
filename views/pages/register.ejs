<%- include('../partials/header',{title:'Crear cuenta'}) %>

<section class="auth-page">
  <div class="auth-card register-card">

    <img
      src="/images/elite-soccer-logo.png"
      alt="Elite Soccer"
    >

    <span class="eyebrow">ÚNETE AL CLUB</span>

    <h1>Crear cuenta</h1>

    <p class="muted center">
      Regístrate como jugador o acudiente.
      Tu cuenta quedará pendiente de aprobación.
    </p>

    <% if(error){ %>
      <div class="alert danger">
        <%= error %>
      </div>
    <% } %>

    <% if(success){ %>

      <div class="alert success">
        <%= success %>
      </div>

      <p class="center">
        <a class="btn full" href="/login">
          IR A INICIAR SESIÓN
        </a>
      </p>

    <% } else { %>

      <form method="post" action="/registro" class="form" id="registerForm">

        <!-- ==========================================
             DATOS DE LA CUENTA
        =========================================== -->

        <div class="form-section">
          <span class="eyebrow">DATOS DE LA CUENTA</span>
        </div>

        <label>
          Nombre completo

          <input
            type="text"
            name="name"
            value="<%= form.name || '' %>"
            minlength="3"
            maxlength="120"
            autocomplete="name"
            placeholder="Ej: Jesús David Riera"
            required
          >
        </label>


        <label>
          Correo electrónico

          <input
            type="email"
            name="email"
            value="<%= form.email || '' %>"
            autocomplete="email"
            placeholder="correo@ejemplo.com"
            required
          >
        </label>


        <label>
          Tipo de cuenta

          <select name="role" id="role" required>

            <option
              value="player"
              <%= form.role === 'player' || !form.role ? 'selected' : '' %>
            >
              ⚽ Jugador
            </option>

            <option
              value="guardian"
              <%= form.role === 'guardian' ? 'selected' : '' %>
            >
              👨‍👩‍👦 Acudiente
            </option>

          </select>
        </label>


        <!-- ==========================================
             DATOS DEL JUGADOR
        =========================================== -->

        <div id="playerFields">

          <div class="form-section">
            <span class="eyebrow">DATOS DEL JUGADOR</span>

            <p class="muted">
              Estos datos nos ayudarán a crear correctamente
              tu perfil deportivo.
            </p>
          </div>


          <label>
            Fecha de nacimiento

            <input
              type="date"
              name="birth_date"
              id="birth_date"
              value="<%= form.birth_date || '' %>"
            >

            <small class="muted">
              Elite Soccer acepta jugadores entre 12 y 18 años.
            </small>
          </label>


          <label>
            Posición

            <select name="position" id="position">

              <option value="">Selecciona tu posición</option>

              <option
                value="goalkeeper"
                <%= form.position === 'goalkeeper' ? 'selected' : '' %>
              >
                🧤 Arquero
              </option>

              <option
                value="defender"
                <%= form.position === 'defender' ? 'selected' : '' %>
              >
                🛡️ Defensor
              </option>

              <option
                value="right_back"
                <%= form.position === 'right_back' ? 'selected' : '' %>
              >
                Lateral derecho
              </option>

              <option
                value="left_back"
                <%= form.position === 'left_back' ? 'selected' : '' %>
              >
                Lateral izquierdo
              </option>

              <option
                value="defensive_midfielder"
                <%= form.position === 'defensive_midfielder' ? 'selected' : '' %>
              >
                Medio centro defensivo
              </option>

              <option
                value="central_midfielder"
                <%= form.position === 'central_midfielder' ? 'selected' : '' %>
              >
                Medio centro
              </option>

              <option
                value="attacking_midfielder"
                <%= form.position === 'attacking_midfielder' ? 'selected' : '' %>
              >
                Medio centro ofensivo
              </option>

              <option
                value="right_midfielder"
                <%= form.position === 'right_midfielder' ? 'selected' : '' %>
              >
                Medio centro derecho
              </option>

              <option
                value="left_midfielder"
                <%= form.position === 'left_midfielder' ? 'selected' : '' %>
              >
                Medio centro izquierdo
              </option>

              <option
                value="right_winger"
                <%= form.position === 'right_winger' ? 'selected' : '' %>
              >
                Extremo derecho
              </option>

              <option
                value="left_winger"
                <%= form.position === 'left_winger' ? 'selected' : '' %>
              >
                Extremo izquierdo
              </option>

              <option
                value="striker"
                <%= form.position === 'striker' ? 'selected' : '' %>
              >
                Delantero
              </option>

              <option
                value="false_nine"
                <%= form.position === 'false_nine' ? 'selected' : '' %>
              >
                Centro / Falso nueve
              </option>

            </select>
          </label>


          <label>
            Pie dominante

            <select name="dominant_foot" id="dominant_foot">

              <option value="">
                Selecciona tu pie dominante
              </option>

              <option
                value="right"
                <%= form.dominant_foot === 'right' ? 'selected' : '' %>
              >
                🦶 Derecho
              </option>

              <option
                value="left"
                <%= form.dominant_foot === 'left' ? 'selected' : '' %>
              >
                🦶 Izquierdo
              </option>

              <option
                value="ambidextrous"
                <%= form.dominant_foot === 'ambidextrous' ? 'selected' : '' %>
              >
                🦶 Ambidiestro
              </option>

            </select>
          </label>


          <div class="form-row">

            <label>
              Estatura

              <input
                type="number"
                name="height_cm"
                value="<%= form.height_cm || '' %>"
                min="50"
                max="250"
                step="0.1"
                placeholder="Ej: 175"
              >

              <small class="muted">
                Centímetros
              </small>
            </label>


            <label>
              Peso

              <input
                type="number"
                name="weight_kg"
                value="<%= form.weight_kg || '' %>"
                min="20"
                max="250"
                step="0.1"
                placeholder="Ej: 68"
              >

              <small class="muted">
                Kilogramos
              </small>
            </label>

          </div>


          <div class="info-box">

            <strong>⚽ Categoría automática</strong>

            <p>
              No necesitas seleccionar tu categoría.
              Elite Soccer la asignará automáticamente
              según tu fecha de nacimiento.
            </p>

          </div>

        </div>


        <!-- ==========================================
             CONTRASEÑA
        =========================================== -->

        <div class="form-section">
          <span class="eyebrow">SEGURIDAD</span>
        </div>


        <label>
          Contraseña

          <input
            type="password"
            name="password"
            minlength="8"
            autocomplete="new-password"
            placeholder="Mínimo 8 caracteres"
            required
          >

          <small class="muted">
            Mínimo 8 caracteres.
          </small>
        </label>


        <label>
          Confirmar contraseña

          <input
            type="password"
            name="confirm_password"
            minlength="8"
            autocomplete="new-password"
            placeholder="Repite tu contraseña"
            required
          >
        </label>


        <button
          class="btn full"
          type="submit"
        >
          CREAR CUENTA
        </button>

      </form>


      <p class="center muted">
        ¿Ya tienes una cuenta?

        <a
          class="link-blue"
          href="/login"
        >
          Iniciar sesión
        </a>
      </p>

    <% } %>

  </div>
</section>


<script>

  const roleSelect = document.getElementById('role');
  const playerFields = document.getElementById('playerFields');

  const birthDate = document.getElementById('birth_date');
  const position = document.getElementById('position');
  const dominantFoot = document.getElementById('dominant_foot');


  function updatePlayerFields() {

    if (roleSelect.value === 'player') {

      playerFields.style.display = 'block';

      birthDate.required = true;
      position.required = true;
      dominantFoot.required = true;

    } else {

      playerFields.style.display = 'none';

      birthDate.required = false;
      position.required = false;
      dominantFoot.required = false;

    }

  }


  roleSelect.addEventListener(
    'change',
    updatePlayerFields
  );


  updatePlayerFields();

</script>


<%- include('../partials/footer') %>