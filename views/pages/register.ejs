<%- include('../partials/header', { title: 'Crear cuenta' }) %>

<section class="auth-page">

  <div class="auth-card">

    <!-- =====================================================
         LOGO
    ====================================================== -->

    <img
      src="/images/elite-soccer-logo.png"
      alt="Elite Soccer"
      class="auth-logo"
    >

    <span class="eyebrow">
      ELITE SOCCER
    </span>

    <h1>
      Crear cuenta
    </h1>

    <p class="muted center">
      Forma parte de nuestra familia.
    </p>


    <!-- =====================================================
         MENSAJES
    ====================================================== -->

    <% if (typeof error !== 'undefined' && error) { %>

      <div class="alert danger">
        <%= error %>
      </div>

    <% } %>


    <% if (typeof success !== 'undefined' && success) { %>

      <div class="alert success">
        <%= success %>
      </div>

    <% } %>


    <!-- =====================================================
         FORMULARIO
    ====================================================== -->

    <form
      method="post"
      action="/registro"
      enctype="multipart/form-data"
      class="form"
      id="registerForm"
    >

      <!-- =================================================
           DATOS DE CUENTA
      ================================================== -->

      <div class="form-section">

        <h3>
          Datos de cuenta
        </h3>

        <!-- NOMBRE -->

        <label>
          Nombre completo

          <input
            type="text"
            name="name"
            value="<%= form?.name || '' %>"
            placeholder="Tu nombre completo"
            minlength="3"
            maxlength="120"
            autocomplete="name"
            required
          >
        </label>


        <!-- EMAIL -->

        <label>
          Correo electrónico

          <input
            type="email"
            name="email"
            value="<%= form?.email || '' %>"
            placeholder="correo@ejemplo.com"
            autocomplete="email"
            required
          >
        </label>


        <!-- TIPO DE CUENTA -->

        <label>
          Tipo de cuenta

          <select
            name="role"
            id="role"
            required
          >

            <option
              value="player"
              <%= form?.role === 'player' || !form?.role ? 'selected' : '' %>
            >
              🧑‍⚽ Jugador
            </option>

            <option
              value="guardian"
              <%= form?.role === 'guardian' ? 'selected' : '' %>
            >
              👨‍👩‍👧 Acudiente
            </option>

            <option
              value="coach"
              <%= form?.role === 'coach' ? 'selected' : '' %>
            >
              🧠 Entrenador
            </option>

          </select>
        </label>


        <!-- CONTRASEÑA -->

        <label>
          Contraseña

          <input
            type="password"
            name="password"
            id="password"
            minlength="8"
            autocomplete="new-password"
            placeholder="Mínimo 8 caracteres"
            required
          >
        </label>


        <!-- CONFIRMAR CONTRASEÑA -->

        <label>
          Confirmar contraseña

          <input
            type="password"
            name="confirm_password"
            id="confirm_password"
            minlength="8"
            autocomplete="new-password"
            placeholder="Repite tu contraseña"
            required
          >
        </label>

      </div>


      <!-- =================================================
           DATOS DEL JUGADOR
      ================================================== -->

      <div
        class="form-section"
        id="playerFields"
      >

        <h3>
          Perfil del jugador
        </h3>

        <p class="muted">
          Estos datos permiten registrar automáticamente
          la categoría del jugador.
        </p>


        <!-- DORSAL -->

        <label>
          Número de camiseta

          <input
            type="number"
            name="dorsal"
            value="<%= form?.dorsal || '' %>"
            min="1"
            max="99"
            placeholder="Ej: 10"
          >
        </label>


        <!-- POSICIÓN -->

        <label>
          Posición

          <select
            name="position"
          >

            <option value="">
              Selecciona tu posición
            </option>

            <option
              value="goalkeeper"
              <%= form?.position === 'goalkeeper' ? 'selected' : '' %>
            >
              Arquero
            </option>

            <option
              value="defender"
              <%= form?.position === 'defender' ? 'selected' : '' %>
            >
              Defensor central
            </option>

            <option
              value="right_back"
              <%= form?.position === 'right_back' ? 'selected' : '' %>
            >
              Lateral derecho
            </option>

            <option
              value="left_back"
              <%= form?.position === 'left_back' ? 'selected' : '' %>
            >
              Lateral izquierdo
            </option>

            <option
              value="defensive_midfielder"
              <%= form?.position === 'defensive_midfielder' ? 'selected' : '' %>
            >
              Medio centro defensivo
            </option>

            <option
              value="central_midfielder"
              <%= form?.position === 'central_midfielder' ? 'selected' : '' %>
            >
              Medio centro
            </option>

            <option
              value="attacking_midfielder"
              <%= form?.position === 'attacking_midfielder' ? 'selected' : '' %>
            >
              Medio centro ofensivo
            </option>

            <option
              value="right_midfielder"
              <%= form?.position === 'right_midfielder' ? 'selected' : '' %>
            >
              Medio centro derecho
            </option>

            <option
              value="left_midfielder"
              <%= form?.position === 'left_midfielder' ? 'selected' : '' %>
            >
              Medio centro izquierdo
            </option>

            <option
              value="right_winger"
              <%= form?.position === 'right_winger' ? 'selected' : '' %>
            >
              Extremo derecho
            </option>

            <option
              value="left_winger"
              <%= form?.position === 'left_winger' ? 'selected' : '' %>
            >
              Extremo izquierdo
            </option>

            <option
              value="striker"
              <%= form?.position === 'striker' ? 'selected' : '' %>
            >
              Delantero
            </option>

            <option
              value="false_nine"
              <%= form?.position === 'false_nine' ? 'selected' : '' %>
            >
              Falso nueve
            </option>

          </select>
        </label>


        <!-- PIERNA DOMINANTE -->

        <label>
          Pierna dominante

          <select name="dominant_foot">

            <option value="">
              Selecciona
            </option>

            <option
              value="right"
              <%= form?.dominant_foot === 'right' ? 'selected' : '' %>
            >
              Derecha
            </option>

            <option
              value="left"
              <%= form?.dominant_foot === 'left' ? 'selected' : '' %>
            >
              Izquierda
            </option>

            <option
              value="ambidextrous"
              <%= form?.dominant_foot === 'ambidextrous' ? 'selected' : '' %>
            >
              Ambidiestro
            </option>

          </select>
        </label>


        <!-- FECHA DE NACIMIENTO -->

        <label>
          Fecha de nacimiento

          <input
            type="date"
            name="birth_date"
            value="<%= form?.birth_date || '' %>"
          >
        </label>


        <!-- ALTURA Y PESO -->

        <div class="form-grid">

          <label>
            Altura (cm)

            <input
              type="number"
              name="height_cm"
              value="<%= form?.height_cm || '' %>"
              min="100"
              max="230"
              step="0.01"
              placeholder="Ej: 175"
            >
          </label>


          <label>
            Peso (kg)

            <input
              type="number"
              name="weight_kg"
              value="<%= form?.weight_kg || '' %>"
              min="20"
              max="180"
              step="0.1"
              placeholder="Ej: 65"
            >
          </label>

        </div>


        <!-- FOTO -->

        <label>
          Foto de perfil

          <input
            type="file"
            name="profile_photo"
            id="profile_photo"
            accept="image/jpeg,image/png,image/webp"
          >

          <small class="muted">
            JPG, PNG o WEBP. Máximo 5 MB.
          </small>
        </label>


        <!-- PREVIEW -->

        <div
          id="photoPreview"
          class="photo-preview"
          style="display:none;"
        >

          <img
            id="previewImage"
            src=""
            alt="Vista previa de la foto del jugador"
          >

        </div>

      </div>


      <!-- =================================================
           DATOS DEL ACUDIENTE
      ================================================== -->

      <div
        class="form-section"
        id="guardianFields"
      >

        <h3>
          Información del acudiente
        </h3>

        <p class="muted">
          Información del padre, madre o tutor responsable
          del jugador.
        </p>


        <!-- NOMBRE -->

        <label>
          Nombre completo del acudiente

          <input
            type="text"
            name="guardian_name"
            value="<%= form?.guardian_name || '' %>"
            placeholder="Nombre del padre, madre o tutor"
            maxlength="160"
          >
        </label>


        <!-- RELACIÓN -->

        <label>
          Relación con el jugador

          <select
            name="guardian_relationship"
            id="guardian_relationship"
          >

            <option value="">
              Selecciona
            </option>

            <option
              value="father"
              <%= form?.guardian_relationship === 'father' ? 'selected' : '' %>
            >
              Padre
            </option>

            <option
              value="mother"
              <%= form?.guardian_relationship === 'mother' ? 'selected' : '' %>
            >
              Madre
            </option>

            <option
              value="guardian"
              <%= form?.guardian_relationship === 'guardian' ? 'selected' : '' %>
            >
              Tutor
            </option>

          </select>
        </label>


        <!-- TELÉFONO -->

        <label>
          Teléfono del acudiente

          <input
            type="tel"
            name="guardian_phone"
            value="<%= form?.guardian_phone || '' %>"
            placeholder="Ej: 3001234567"
            maxlength="40"
            autocomplete="tel"
          >
        </label>


        <!-- CORREO -->

        <label>
          Correo del acudiente

          <input
            type="email"
            name="guardian_email"
            value="<%= form?.guardian_email || '' %>"
            placeholder="acudiente@ejemplo.com"
            maxlength="180"
            autocomplete="email"
          >
        </label>


        <div class="registration-info">

          <strong>
            Información importante
          </strong>

          <p>
            El acudiente será registrado como responsable
            del jugador dentro de Elite Soccer.
          </p>

          <p>
            Esta información será utilizada para comunicaciones
            importantes relacionadas con el jugador.
          </p>

        </div>

      </div>


      <!-- =================================================
           DATOS DEL ENTRENADOR
      ================================================== -->

      <div
        class="form-section"
        id="coachFields"
        style="display:none;"
      >

        <h3>
          Perfil del entrenador
        </h3>

        <p class="muted">
          Completa los datos necesarios para registrar
          tu cuenta como entrenador.
        </p>


        <!-- CÓDIGO DEL ENTRENADOR -->

        <label>
          Código secreto de entrenador

          <input
            type="password"
            name="coach_code"
            id="coach_code"
            value="<%= form?.coach_code || '' %>"
            placeholder="Ingresa el código secreto"
            autocomplete="off"
          >

          <small class="muted">
            Este código es proporcionado únicamente por
            Elite Soccer.
          </small>
        </label>


        <!-- FECHA -->

        <label>
          Fecha de nacimiento

          <input
            type="date"
            name="coach_birth_date"
            value="<%= form?.coach_birth_date || '' %>"
          >
        </label>


        <!-- TELÉFONO -->

        <label>
          Teléfono

          <input
            type="tel"
            name="coach_phone"
            value="<%= form?.coach_phone || '' %>"
            placeholder="Ej: 3001234567"
            maxlength="40"
            autocomplete="tel"
          >
        </label>


        <!-- BIOGRAFÍA -->

        <label>
          Biografía

          <textarea
            name="coach_bio"
            rows="4"
            maxlength="2000"
            placeholder="Cuéntanos brevemente sobre ti..."
          ><%= form?.coach_bio || '' %></textarea>
        </label>


        <!-- EXPERIENCIA -->

        <label>
          Experiencia

          <textarea
            name="coach_experience"
            rows="4"
            maxlength="2000"
            placeholder="Experiencia como entrenador..."
          ><%= form?.coach_experience || '' %></textarea>
        </label>


        <!-- ESPECIALIDAD -->

        <label>
          Especialidad

          <input
            type="text"
            name="coach_specialty"
            value="<%= form?.coach_specialty || '' %>"
            placeholder="Ej: Formación de jóvenes"
            maxlength="160"
          >
        </label>


        <!-- FORMACIÓN -->

        <label>
          Formación preferida

          <input
            type="text"
            name="preferred_formation"
            value="<%= form?.preferred_formation || '' %>"
            placeholder="Ej: 3-1-2"
            maxlength="80"
          >
        </label>


        <!-- FOTO ENTRENADOR -->

        <label>
          Foto de perfil

          <input
            type="file"
            name="coach_photo"
            id="coach_photo"
            accept="image/jpeg,image/png,image/webp"
          >

          <small class="muted">
            JPG, PNG o WEBP. Máximo 5 MB.
          </small>
        </label>


        <!-- PREVIEW ENTRENADOR -->

        <div
          id="coachPhotoPreview"
          class="photo-preview"
          style="display:none;"
        >

          <img
            id="coachPreviewImage"
            src=""
            alt="Vista previa de la foto del entrenador"
          >

        </div>


        <div class="registration-info">

          <strong>
            Cuenta de entrenador
          </strong>

          <p>
            El código secreto es obligatorio para registrar
            una cuenta de entrenador.
          </p>

          <p>
            Las cuentas autorizadas de entrenador son
            aprobadas automáticamente.
          </p>

        </div>

      </div>


      <!-- =================================================
           INFORMACIÓN JUGADOR
      ================================================== -->

      <div
        class="registration-info"
        id="playerInfo"
      >

        <strong>
          Importante
        </strong>

        <p>
          Los jugadores de Elite Soccer tienen entre
          12 y 18 años.
        </p>

        <p>
          Tu categoría se asignará automáticamente
          según tu edad.
        </p>

        <p>
          Después de registrarte, un administrador deberá
          aprobar tu cuenta antes de que puedas iniciar sesión.
        </p>

      </div>


      <!-- =================================================
           INFORMACIÓN ACUDIENTE
      ================================================== -->

      <div
        class="registration-info"
        id="guardianInfo"
        style="display:none;"
      >

        <strong>
          Cuenta de acudiente
        </strong>

        <p>
          Tu cuenta quedará pendiente de aprobación
          por parte de Elite Soccer.
        </p>

      </div>


      <!-- =================================================
           BOTÓN
      ================================================== -->

      <button
        type="submit"
        class="btn full"
        id="registerButton"
      >
        CREAR CUENTA
      </button>

    </form>


    <!-- =====================================================
         LOGIN
    ====================================================== -->

    <div class="register-link">

      <p class="muted">

        ¿Ya tienes una cuenta?

        <a
          href="/login"
          class="link-blue"
        >
          Iniciar sesión
        </a>

      </p>

    </div>

  </div>

</section>


<script>

(function () {

  'use strict';


  // ==========================================================
  // ELEMENTOS
  // ==========================================================

  const role =
    document.getElementById('role');

  const playerFields =
    document.getElementById('playerFields');

  const guardianFields =
    document.getElementById('guardianFields');

  const coachFields =
    document.getElementById('coachFields');

  const playerInfo =
    document.getElementById('playerInfo');

  const guardianInfo =
    document.getElementById('guardianInfo');

  const coachSecret =
    document.getElementById('coach_code');

  const coachPhoto =
    document.getElementById('coach_photo');

  const coachPhotoPreview =
    document.getElementById('coachPhotoPreview');

  const coachPreviewImage =
    document.getElementById('coachPreviewImage');

  const playerPhoto =
    document.getElementById('profile_photo');

  const playerPhotoPreview =
    document.getElementById('photoPreview');

  const playerPreviewImage =
    document.getElementById('previewImage');

  const form =
    document.getElementById('registerForm');

  const button =
    document.getElementById('registerButton');


  // ==========================================================
  // CAMBIAR TIPO DE CUENTA
  // ==========================================================

  function updateRole() {

    const selected =
      role.value;

    const isPlayer =
      selected === 'player';

    const isGuardian =
      selected === 'guardian';

    const isCoach =
      selected === 'coach';


    // --------------------------------------------------------
    // JUGADOR
    // --------------------------------------------------------

    playerFields.style.display =
      isPlayer ? 'block' : 'none';

    playerInfo.style.display =
      isPlayer ? 'block' : 'none';


    // --------------------------------------------------------
    // ACUDIENTE
    // --------------------------------------------------------

    /*
     * Los datos del acudiente pertenecen al jugador.
     * Por eso aparecen cuando se registra un jugador.
     */

    guardianFields.style.display =
      isPlayer ? 'block' : 'none';

    guardianInfo.style.display =
      isGuardian ? 'block' : 'none';


    // --------------------------------------------------------
    // ENTRENADOR
    // --------------------------------------------------------

    coachFields.style.display =
      isCoach ? 'block' : 'none';


    // --------------------------------------------------------
    // CAMPOS DEL JUGADOR
    // --------------------------------------------------------

    const playerInputs =
      playerFields.querySelectorAll(
        'input, select, textarea'
      );

    playerInputs.forEach(
      function (input) {

        input.required =
          isPlayer;

      }
    );


    // --------------------------------------------------------
    // CAMPOS DEL ACUDIENTE
    // --------------------------------------------------------

    const guardianInputs =
      guardianFields.querySelectorAll(
        'input, select, textarea'
      );

    guardianInputs.forEach(
      function (input) {

        input.required =
          false;

      }
    );


    // --------------------------------------------------------
    // CAMPOS DEL ENTRENADOR
    // --------------------------------------------------------

    const coachInputs =
      coachFields.querySelectorAll(
        'input, select, textarea'
      );

    coachInputs.forEach(
      function (input) {

        input.required =
          false;

      }
    );


    /*
     * El código secreto sí es obligatorio
     * cuando la cuenta es de entrenador.
     */

    coachSecret.required =
      isCoach;


    // --------------------------------------------------------
    // FOTOS
    // --------------------------------------------------------

    playerPhoto.required =
      false;

    coachPhoto.required =
      false;

  }


  // ==========================================================
  // EVENTO CAMBIO DE ROL
  // ==========================================================

  role.addEventListener(
    'change',
    updateRole
  );


  updateRole();


  // ==========================================================
  // PREVIEW FOTO JUGADOR
  // ==========================================================

  playerPhoto.addEventListener(
    'change',
    function () {

      const file =
        playerPhoto.files[0];


      if (!file) {

        playerPhotoPreview.style.display =
          'none';

        playerPreviewImage.src =
          '';

        return;

      }


      if (!file.type.startsWith('image/')) {

        alert(
          'Selecciona una imagen válida.'
        );

        playerPhoto.value =
          '';

        playerPhotoPreview.style.display =
          'none';

        return;

      }


      if (file.size > 5 * 1024 * 1024) {

        alert(
          'La imagen no puede superar los 5 MB.'
        );

        playerPhoto.value =
          '';

        playerPhotoPreview.style.display =
          'none';

        return;

      }


      const reader =
        new FileReader();


      reader.onload =
        function (event) {

          playerPreviewImage.src =
            event.target.result;

          playerPhotoPreview.style.display =
            'block';

        };


      reader.readAsDataURL(file);

    }
  );


  // ==========================================================
  // PREVIEW FOTO ENTRENADOR
  // ==========================================================

  coachPhoto.addEventListener(
    'change',
    function () {

      const file =
        coachPhoto.files[0];


      if (!file) {

        coachPhotoPreview.style.display =
          'none';

        coachPreviewImage.src =
          '';

        return;

      }


      if (!file.type.startsWith('image/')) {

        alert(
          'Selecciona una imagen válida.'
        );

        coachPhoto.value =
          '';

        coachPhotoPreview.style.display =
          'none';

        return;

      }


      if (file.size > 5 * 1024 * 1024) {

        alert(
          'La imagen no puede superar los 5 MB.'
        );

        coachPhoto.value =
          '';

        coachPhotoPreview.style.display =
          'none';

        return;

      }


      const reader =
        new FileReader();


      reader.onload =
        function (event) {

          coachPreviewImage.src =
            event.target.result;

          coachPhotoPreview.style.display =
            'block';

        };


      reader.readAsDataURL(file);

    }
  );


  // ==========================================================
  // VALIDAR FORMULARIO
  // ==========================================================

  form.addEventListener(
    'submit',
    function (event) {

      const password =
        document.getElementById('password').value;

      const confirmPassword =
        document.getElementById('confirm_password').value;


      // ------------------------------------------------------
      // CONTRASEÑAS
      // ------------------------------------------------------

      if (password !== confirmPassword) {

        event.preventDefault();

        alert(
          'Las contraseñas no coinciden.'
        );

        return;

      }


      // ------------------------------------------------------
      // CÓDIGO ENTRENADOR
      // ------------------------------------------------------

      if (role.value === 'coach') {

        if (!coachSecret.value.trim()) {

          event.preventDefault();

          alert(
            'Debes ingresar el código secreto de entrenador.'
          );

          coachSecret.focus();

          return;

        }

      }


      // ------------------------------------------------------
      // VALIDACIÓN JUGADOR
      // ------------------------------------------------------

      if (role.value === 'player') {

        const position =
          document.querySelector(
            'select[name="position"]'
          ).value;


        if (!position) {

          event.preventDefault();

          alert(
            'Debes seleccionar tu posición.'
          );

          return;

        }

      }


      // ------------------------------------------------------
      // DESACTIVAR BOTÓN
      // ------------------------------------------------------

      button.disabled =
        true;

      button.textContent =
        'CREANDO CUENTA...';

    }
  );

})();

</script>


<%- include('../partials/footer') %>