<%- include('../partials/header',{title:'Reportes'}) %><div class="page-head"><h1>Reportes deportivos</h1></div><section class="panel"><h2>Asistencia</h2><div class="table-wrap"><table><thead><tr><th>Jugador</th><th>Total</th><th>Presentes</th><th>Tarde</th><th>%</th></tr></thead><tbody><%attendance.forEach(a=>{%><tr><td><%=a.full_name%></td><td><%=a.total%></td><td><%=a.present%></td><td><%=a.late%></td><td><strong><%=a.percentage||0%>%</strong></td></tr><%})%></tbody></table></div></section><section class="panel"><h2>Goles y asistencias</h2><div class="table-wrap"><table><thead><tr><th>Jugador</th><th>Goles</th><th>Asistencias</th></tr></thead><tbody><%scorers.forEach(s=>{%><tr><td><%=s.full_name%></td><td><%=s.goals%></td><td><%=s.assists%></td></tr><%})%></tbody></table></div></section><%- include('../partials/footer') %>
