<%- include('../partials/header',{title:'Elite Shop'}) %><div class="page-head"><div><span class="eyebrow">ELITE SHOP</span><h1>Kit oficial y productos</h1></div></div><div class="grid cards"><%products.forEach(p=>{%><article class="card product"><%if(p.image_url){%><img class="product-img" src="<%=p.image_url%>"><%}%><span>OFICIAL</span><h3><%=p.name%></h3><p><%=p.description||''%></p><strong>$<%=Number(p.price).toLocaleString('es-CO')%></strong><%if(user){%><form method="post" action="/tienda/pedido" class="form"><input type="hidden" name="product_id" value="<%=p.id%>"><input name="name" placeholder="Nombre para personalizar"><input name="dorsal" type="number" placeholder="Dorsal"><select name="size"><option>S</option><option>M</option><option>L</option><option>XL</option></select><input name="quantity" type="number" min="1" value="1"><button class="btn full">Pedir</button></form><%}%></article><%})%></div><%- include('../partials/footer') %>
