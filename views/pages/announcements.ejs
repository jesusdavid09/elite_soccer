<%- include('../partials/header',{title:'Anuncios'}) %><div class="page-head"><h1>Comunicados</h1></div><form method="post" class="panel form grid-form"><label>Título<input name="title" required></label><label>Prioridad<select name="priority"><option>normal</option><option>high</option></select></label><label>Audiencia<select name="audience"><option value="all">Todos</option><option value="player">Jugadores</option><option value="guardian">Acudientes</option><option value="coach">Entrenadores</option></select></label><label class="full-row">Mensaje<textarea name="message" required></textarea></label><button class="btn">Publicar</button></form><div class="panel"><%announcements.forEach(a=>{%><article class="announcement"><span><%=a.priority%></span><h3><%=a.title%></h3><p><%=a.message%></p><small><%=a.author_name||'Elite Soccer'%> · <%=a.created_at.toLocaleString('es-CO')%></small></article><%})%></div><%- include('../partials/footer') %>
