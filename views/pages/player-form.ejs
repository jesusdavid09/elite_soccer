<%- include('../partials/header',{title:'Nuevo jugador'}) %><div class="page-head"><h1>Nuevo jugador</h1></div><form class="panel form grid-form" method="post" action="/jugadores" enctype="multipart/form-data"><label>Nombre completo<input name="full_name" required></label><label>Dorsal<input name="dorsal" type="number" min="1" max="99"></label><label>Posición<select name="position"><option>Arquero</option><option>Defensa</option><option>Lateral derecho</option><option>Lateral izquierdo</option><option>Medio centro</option><option>Medio defensivo</option><option>Medio ofensivo</option><option>Extremo derecho</option><option>Extremo izquierdo</option><option>Delantero</option><option>Falso 9</option></select></label><label>Pie dominante<select name="dominant_foot"><option>Derecho</option><option>Izquierdo</option><option>Ambidiestro</option></select></label><label>Fecha de nacimiento<input name="birth_date" type="date"></label><label>Altura (cm)<input name="height_cm" type="number" step="0.01"></label><label>Peso (kg)<input name="weight_kg" type="number" step="0.01"></label><label>Categoría<select name="category_id"><option value="">Sin categoría</option><%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></label><label>Foto<input name="photo" type="file" accept="image/*"></label><div class="full-row"><button class="btn">Guardar jugador</button></div></form><%- include('../partials/footer') %>
