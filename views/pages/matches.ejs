<%- include('../partials/header',{title:'Partidos'}) %><div class="page-head"><div><span class="eyebrow">COMPETICIÓN</span><h1>Partidos</h1></div><%if(['admin','coach'].includes(user.role)){%><a class="btn" href="/partidos/nuevo">+ Nuevo partido</a><%}%></div><div class="grid cards"><%matches.forEach(m=>{%><a class="card match" href="/partidos/<%=m.id%>"><span><%=m.status%> · <%=m.competition||'Partido'%></span><h3>ELITE SOCCER <b><%=m.elite_goals!=null?m.elite_goals:'VS'%></b> <%=m.opponent%> <%=m.opponent_goals!=null?m.opponent_goals:''%></h3><p><%=m.match_date.toLocaleDateString('es-CO')%> · <%=String(m.match_time||'').slice(0,5)%> · <%=m.location||'—'%></p></a><%})%></div><%- include('../partials/footer') %>
