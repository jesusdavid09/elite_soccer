<%- include('../partials/header',{title:'Convocatoria'}) %><div class="page-head"><div><span class="eyebrow">CONVOCATORIA</span><h1>VS <%=match.opponent%></h1><p><%=match.match_date.toLocaleDateString('es-CO')%> · <%=String(match.match_time||'').slice(0,5)%></p></div></div><form method="post" class="panel"><div class="grid mini-cards"><%players.forEach(p=>{%><label class="select-card"><input type="checkbox" name="player_id" value="<%=p.id%>" <%=p.callup_status==='pending'||p.callup_status==='confirmed'?'checked':''%>><span>#<%=p.dorsal||'—'%></span><strong><%=p.full_name%></strong><small><%=p.position||''%></small></label><%})%></div><button class="btn">Publicar convocatoria</button></form><%- include('../partials/footer') %>
