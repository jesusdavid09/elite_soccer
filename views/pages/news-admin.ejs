<%- include('../partials/header',{title:'Gestionar noticias'}) %><div class="page-head"><h1>Gestionar noticias</h1></div><form method="post" action="/noticias/admin" enctype="multipart/form-data" class="panel form grid-form"><label>Título<input name="title" required></label><label>Imagen<input type="file" name="image" accept="image/*"></label><label class="full-row">Resumen<textarea name="excerpt"></textarea></label><label class="full-row">Contenido<textarea name="content" required></textarea></label><label><input type="checkbox" name="published"> Publicar ahora</label><button class="btn">Crear noticia</button></form><div class="table-wrap"><table><thead><tr><th>Título</th><th>Estado</th><th></th></tr></thead><tbody><%news.forEach(n=>{%><tr><td><%=n.title%></td><td><%=n.published?'Publicada':'Borrador'%></td><td><form method="post" action="/noticias/admin/<%=n.id%>/toggle"><button class="ghost">Cambiar</button></form></td></tr><%})%></tbody></table></div><%- include('../partials/footer') %>
