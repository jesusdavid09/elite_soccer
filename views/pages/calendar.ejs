<%- include('../partials/header',{title:'Calendario'}) %><div class="page-head"><h1>Calendario deportivo</h1></div><div class="calendar-list"><%events.sort((a,b)=>new Date(a.date).getTime()-new Date(b.date).getTime()).forEach(e=>{%><div class="calendar-item <%=e.kind%>"><span><%=e.kind==='match'?'⚽':'🏃'%></span><div><strong><%=e.match_title||e.title%></strong><small><%=new Date(e.date).toLocaleDateString('es-CO')%> · <%=String(e.start_time||'').slice(0,5)%> · <%=e.location||''%></small></div></div><%})%></div><%- include('../partials/footer') %>
