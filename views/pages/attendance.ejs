<%- include('../partials/header',{title:'Asistencia'}) %><div class="page-head"><div><span class="eyebrow">ASISTENCIA</span><h1><%=training.title%></h1><p><%=training.date.toLocaleDateString('es-CO')%> · <%=String(training.start_time).slice(0,5)%></p></div></div><form method="post" class="panel"><div class="table-wrap"><table><thead><tr><th>Jugador</th><th>Presente</th><th>Estado</th><th>Nota</th></tr></thead><tbody><%players.forEach(p=>{%><tr><td><%=p.full_name%></td><td><input type="checkbox" name="player_id" value="<%=p.id%>" <%=['present','late'].includes(p.status)?'checked':''%>></td><td><select name="status[<%=p.id%>]"><option value="present">Presente</option><option value="late">Tarde</option><option value="justified">Justificado</option><option value="absent">Ausente</option></select></td><td><input name="note[<%=p.id%>]" value="<%=p.note||''%>"></td></tr><%})%></tbody></table></div><button class="btn">Guardar asistencia</button></form><%- include('../partials/footer') %>
