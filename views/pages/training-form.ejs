<%- include('../partials/header',{title:'Nuevo entrenamiento'}) %><div class="page-head"><h1>Crear entrenamiento</h1></div><form class="panel form grid-form" method="post" action="/entrenamientos"><label>Título<input name="title" required></label><label>Tipo<select name="training_type"><option>Técnico</option><option>Táctico</option><option>Físico</option><option>Velocidad</option><option>Resistencia</option><option>Definición</option><option>Posesión</option><option>Partido</option></select></label><label>Fecha<input type="date" name="date" required></label><label>Hora<input type="time" name="start_time" required></label><label>Lugar<input name="location"></label><label>Duración (min)<input type="number" name="duration_minutes"></label><label>Categoría<select name="category_id"><option value="">Todas</option><%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></label><label class="full-row">Objetivo<textarea name="objective"></textarea></label><label class="full-row">Notas<textarea name="notes"></textarea></label><div class="full-row"><button class="btn">Crear entrenamiento</button></div></form><%- include('../partials/footer') %>
