<%- include('../partials/header',{title:'Torneos'}) %><div class="page-head"><h1>Torneos</h1></div><div class="grid cards"><%tournaments.forEach(t=>{%><article class="card"><span><%=t.category_name||'Elite'%></span><h3><%=t.name%></h3><p><%=t.start_date?t.start_date.toLocaleDateString('es-CO'):''%> → <%=t.end_date?t.end_date.toLocaleDateString('es-CO'):''%></p><p><%=t.location||'—'%> · <%=t.format||'Formato por definir'%></p></article><%})%></div><%if(['admin','coach'].includes(user.role)){%><form method="post" class="panel form grid-form"><h2 class="full-row">Nuevo torneo</h2><label>Nombre<input name="name" required></label><label>Inicio<input type="date" name="start_date"></label><label>Fin<input type="date" name="end_date"></label><label>Lugar<input name="location"></label><label>Formato<input name="format"></label><label>Notas<textarea name="notes"></textarea></label><button class="btn">Guardar</button></form><%}%><%- include('../partials/footer') %>
