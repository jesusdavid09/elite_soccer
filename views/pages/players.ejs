<%- include('../partials/header',{title:'Jugadores'}) %><div class="page-head"><div><span class="eyebrow">GESTIÓN DE PLANTILLA</span><h1>Jugadores</h1></div><% if(['admin','coach'].includes(user.role)){%><a class="btn" href="/jugadores/nuevo">+ Nuevo jugador</a><%}%></div><div class="table-wrap"><table><thead><tr><th>Jugador</th><th>Dorsal</th><th>Posición</th><th>Categoría</th><th>Pie</th><th></th></tr></thead><tbody><%players.forEach(p=>{%><tr><td><a href="/jugadores/<%=p.id%>"><%=p.full_name%></a></td><td>#<%=p.dorsal||'—'%></td><td><%=p.position||'—'%></td><td><%=p.category_name||'—'%></td><td><%=p.dominant_foot||'—'%></td><td><%if(['admin','coach'].includes(user.role)){%><form method="post" action="/jugadores/<%=p.id%>/desactivar"><button class="ghost" onclick="return confirm('¿Desactivar jugador?')">Desactivar</button></form><%}%></td></tr><%})%></tbody></table></div><%- include('../partials/footer') %>
