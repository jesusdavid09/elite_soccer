<%- include('../partials/header',{title:player.full_name}) %><div class="profile-hero"><div class="profile-photo"><%if(player.photo_url){%><img src="<%=player.photo_url%>"><%}else{%><span>#<%=player.dorsal||'—'%></span><%}%></div><div><span class="eyebrow"><%=player.category_name||'ELITE SOCCER'%></span><h1><%=player.full_name%></h1><p>#<%=player.dorsal||'—'%> · <%=player.position||'Jugador'%> · <%=player.dominant_foot||'—'%></p></div></div><div class="stats"><div><span>PARTIDOS</span><strong><%=stats.matches%></strong></div><div><span>GOLES</span><strong><%=stats.goals%></strong></div><div><span>ASISTENCIAS</span><strong><%=stats.assists%></strong></div><div><span>MVP</span><strong><%=stats.mvps%></strong></div></div><section class="panel"><div class="section-head"><h2>Evaluaciones</h2></div><%evaluations.forEach(e=>{%><div class="evaluation"><div><strong><%=e.evaluated_at.toLocaleDateString('es-CO')%></strong><small>por <%=e.evaluator_name||'Entrenador'%></small></div><div class="scores"><span>Pase <b><%=e.passing%></b></span><span>Control <b><%=e.control%></b></span><span>Regate <b><%=e.dribbling%></b></span><span>Tiro <b><%=e.shooting%></b></span><span>Defensa <b><%=e.defense%></b></span><span>Velocidad <b><%=e.speed%></b></span><span>Táctica <b><%=e.tactics%></b></span></div><p><strong>Fortalezas:</strong> <%=e.strengths||'—'%></p><p><strong>Mejorar:</strong> <%=e.improvements||'—'%></p></div><%})%></section><%- include('../partials/footer') %>
