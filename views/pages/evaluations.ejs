<%- include('../partials/header',{title:'Evaluaciones'}) %><div class="page-head"><div><span class="eyebrow">DESARROLLO</span><h1>Evaluar jugador</h1></div></div><div class="grid cards"><%players.forEach(p=>{%><article class="card"><h3><%=p.full_name%></h3><form class="form" method="post" action="/evaluaciones/<%=p.id%>"><div class="score-grid"><%['passing','control','dribbling','shooting','defense','speed','endurance','tactics','decision_making','discipline'].forEach(k=>{%><label><%=k%><input type="number" min="1" max="10" name="<%=k%>" value="7" required></label><%})%></div><label>Fortalezas<textarea name="strengths"></textarea></label><label>Mejoras<textarea name="improvements"></textarea></label><button class="btn full">Guardar evaluación</button></form></article><%})%></div><%- include('../partials/footer') %>
