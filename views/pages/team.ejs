<%- include('../partials/header',{title:'Equipo'}) %><div class="page-head"><span class="eyebrow">PLANTILLA</span><h1>Equipo Elite Soccer</h1></div><div class="grid players"><% players.forEach(p=>{ %><a class="player-card" href="/jugadores/<%=p.id%>"><div class="player-photo"><%if(p.photo_url){%><img src="<%=p.photo_url%>"><%}else{%><span>#<%=p.dorsal||'—'%></span><%}%></div><div><strong><%=p.full_name%></strong><small>#<%=p.dorsal||'—'%> · <%=p.position||'Jugador'%> · <%=p.category_name||'Elite'%></small></div></a><% }) %></div><%- include('../partials/footer') %>
