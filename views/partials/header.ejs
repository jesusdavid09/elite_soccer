<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <meta name="theme-color" content="#145CFF">

    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="/css/app.css">

    <title><%= title || clubName %> | Elite Soccer</title>
</head>

<body>

<header class="topbar">

    <a class="brand" href="/">
        <img src="/images/elite-soccer-logo.png" alt="Elite Soccer">

        <span>
            ELITE<br>
            <small>SOCCER</small>
        </span>
    </a>

    <nav class="desktop-nav">

        <a href="/">Inicio</a>
        <a href="/equipo">Equipo</a>
        <a href="/partidos">Partidos</a>
        <a href="/calendario">Calendario</a>
        <a href="/noticias">Noticias</a>
        <a href="/galeria">Galería</a>
        <a href="/tienda">Tienda</a>

        <% if(user && ['admin','coach'].includes(user.role)){ %>
            <a href="/noticias/admin">CMS</a>
        <% } %>

    </nav>

    <div class="top-actions">

        <% if(user){ %>

            <a class="icon" href="/notificaciones">
                🔔 <%= unread %>
            </a>

            <a class="btn small" href="/dashboard">
                Dashboard
            </a>

            <form method="post" action="/logout">
                <button class="ghost small" type="submit">
                    Salir
                </button>
            </form>

        <% } else { %>

            <a class="ghost small" href="/registro">
                Registrarse
            </a>

            <a class="btn small" href="/login">
                Iniciar sesión
            </a>

        <% } %>

    </div>

</header>

<main class="shell">